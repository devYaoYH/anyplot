#!/usr/bin/env python3
"""
AnyPlot CLI - Command-line utility for AnyPlot operations

Usage:
    anyplot <command> [options]

Commands:
    test-viz        Test visualization generation with a dataset
    validate-code   Validate generated visualization code
    check-privacy   Analyze privacy budget for a dataset
    export-session  Export session data
    import-session  Import session data
    dev-server      Start development server
    generate-examples Generate example visualizations

Run 'anyplot <command> --help' for command-specific help.
"""

import sys
import argparse
import json
import subprocess
from pathlib import Path
from typing import Optional

# Colors for terminal output
class Colors:
    HEADER = '\033[95m'
    OKBLUE = '\033[94m'
    OKCYAN = '\033[96m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'

def print_success(msg: str):
    print(f"{Colors.OKGREEN}✓ {msg}{Colors.ENDC}")

def print_error(msg: str):
    print(f"{Colors.FAIL}✗ {msg}{Colors.ENDC}", file=sys.stderr)

def print_info(msg: str):
    print(f"{Colors.OKCYAN}ℹ {msg}{Colors.ENDC}")

def print_warning(msg: str):
    print(f"{Colors.WARNING}⚠ {msg}{Colors.ENDC}")

def get_project_root() -> Path:
    """Get the project root directory"""
    cli_dir = Path(__file__).parent.absolute()
    return cli_dir.parent

def test_viz(args):
    """Test visualization generation with a dataset"""
    import pandas as pd
    import sys
    from pathlib import Path
    
    # Add project to path
    project_root = get_project_root()
    sys.path.insert(0, str(project_root / "server"))
    sys.path.insert(0, str(project_root / "mcp"))
    
    dataset_path = Path(args.dataset)
    if not dataset_path.exists():
        print_error(f"Dataset not found: {dataset_path}")
        return 1
    
    print_info(f"Loading dataset: {dataset_path}")
    try:
        df = pd.read_csv(dataset_path)
        print_success(f"Loaded {len(df)} rows, {len(df.columns)} columns")
        print(f"\nColumns: {', '.join(df.columns)}")
        print(f"\nFirst few rows:")
        print(df.head())
    except Exception as e:
        print_error(f"Failed to load dataset: {e}")
        return 1
    
    # Mock visualization test
    prompt = args.prompt or "Create a visualization of this data"
    print_info(f"\nPrompt: {prompt}")
    print_info("Testing visualization generation...")
    
    # Check if server is running
    try:
        import requests
        response = requests.get("http://localhost:8000/health", timeout=2)
        if response.status_code == 200:
            print_success("Server is running")
            
            # Test actual API call
            if not args.dry_run:
                print_info("Sending visualization request...")
                viz_response = requests.post(
                    "http://localhost:8000/visualize",
                    json={
                        "data": df.to_dict('records'),
                        "prompt": prompt,
                        "session_id": "cli-test"
                    },
                    timeout=60
                )
                if viz_response.status_code == 200:
                    result = viz_response.json()
                    print_success("Visualization generated successfully!")
                    if args.save:
                        output_path = Path(args.save)
                        import base64
                        with open(output_path, 'wb') as f:
                            f.write(base64.b64decode(result['image']))
                        print_success(f"Saved to: {output_path}")
                else:
                    print_error(f"API error: {viz_response.status_code}")
                    print(viz_response.text)
                    return 1
        else:
            print_warning("Server returned non-200 status")
    except requests.exceptions.ConnectionError:
        print_warning("Server not running at localhost:8000")
        print_info("Start server with: anyplot dev-server")
        if not args.dry_run:
            return 1
    except Exception as e:
        print_error(f"Error: {e}")
        return 1
    
    return 0

def validate_code(args):
    """Validate generated visualization code"""
    code_path = Path(args.file)
    if not code_path.exists():
        print_error(f"Code file not found: {code_path}")
        return 1
    
    print_info(f"Validating code: {code_path}")
    
    with open(code_path) as f:
        code = f.read()
    
    # Check for dangerous imports
    dangerous_imports = ['os', 'subprocess', 'socket', 'sys', '__import__']
    issues = []
    
    for imp in dangerous_imports:
        if f"import {imp}" in code or f"from {imp}" in code:
            issues.append(f"Dangerous import detected: {imp}")
    
    # Check for required imports
    if 'matplotlib' not in code:
        issues.append("Warning: matplotlib not imported")
    
    # Basic syntax check
    try:
        compile(code, '<string>', 'exec')
        print_success("Syntax is valid")
    except SyntaxError as e:
        issues.append(f"Syntax error: {e}")
    
    if issues:
        print_warning("Validation issues found:")
        for issue in issues:
            print(f"  - {issue}")
        return 1 if any("error" in i.lower() for i in issues) else 0
    else:
        print_success("Code validation passed")
        return 0

def check_privacy(args):
    """Analyze privacy budget for a dataset"""
    import pandas as pd
    import sys
    from pathlib import Path
    
    # Add project to path
    project_root = get_project_root()
    sys.path.insert(0, str(project_root / "mcp"))
    
    dataset_path = Path(args.dataset)
    if not dataset_path.exists():
        print_error(f"Dataset not found: {dataset_path}")
        return 1
    
    print_info(f"Analyzing privacy for: {dataset_path}")
    
    try:
        from sanctum_mcp.privacy import SanctumPrivacy
        
        df = pd.read_csv(dataset_path)
        privacy = SanctumPrivacy(df, epsilon_budget=args.epsilon)
        
        print_success(f"Dataset loaded: {len(df)} rows")
        print(f"\nPrivacy Configuration:")
        print(f"  Epsilon budget: {args.epsilon}")
        print(f"  Columns: {len(df.columns)}")
        
        # Estimate queries allowed
        avg_cost = 1.0  # Average cost per query
        estimated_queries = int(args.epsilon / avg_cost)
        
        print(f"\nEstimated queries allowed: ~{estimated_queries}")
        print(f"  (Based on average epsilon cost of {avg_cost} per query)")
        
        print_info("\nPrivacy recommendations:")
        if args.epsilon < 0.5:
            print("  ✓ Very strong privacy protection")
        elif args.epsilon < 1.0:
            print("  ✓ Strong privacy protection")
        elif args.epsilon < 2.0:
            print("  ⚠ Moderate privacy protection")
        else:
            print("  ⚠ Weaker privacy protection - consider lowering epsilon")
            
    except ImportError:
        print_error("Failed to import sanctum_mcp - ensure it's installed")
        print_info("Run: uv pip install -e ./mcp")
        return 1
    except Exception as e:
        print_error(f"Analysis failed: {e}")
        return 1
    
    return 0

def export_session(args):
    """Export session data"""
    print_info(f"Exporting session: {args.session_id}")
    
    try:
        import requests
        response = requests.get(
            f"http://localhost:8000/api/session/{args.session_id}",
            timeout=5
        )
        
        if response.status_code == 200:
            session_data = response.json()
            output_path = Path(args.output or f"session_{args.session_id}.json")
            
            with open(output_path, 'w') as f:
                json.dump(session_data, f, indent=2)
            
            print_success(f"Session exported to: {output_path}")
            return 0
        else:
            print_error(f"Failed to export session: {response.status_code}")
            return 1
            
    except requests.exceptions.ConnectionError:
        print_error("Server not running at localhost:8000")
        return 1
    except Exception as e:
        print_error(f"Export failed: {e}")
        return 1

def import_session(args):
    """Import session data"""
    session_path = Path(args.file)
    if not session_path.exists():
        print_error(f"Session file not found: {session_path}")
        return 1
    
    print_info(f"Importing session: {session_path}")
    
    try:
        with open(session_path) as f:
            session_data = json.load(f)
        
        import requests
        response = requests.post(
            "http://localhost:8000/api/session/import",
            json=session_data,
            timeout=10
        )
        
        if response.status_code == 200:
            result = response.json()
            print_success(f"Session imported: {result['session_id']}")
            return 0
        else:
            print_error(f"Import failed: {response.status_code}")
            return 1
            
    except requests.exceptions.ConnectionError:
        print_error("Server not running at localhost:8000")
        return 1
    except Exception as e:
        print_error(f"Import failed: {e}")
        return 1

def dev_server(args):
    """Start development server"""
    project_root = get_project_root()
    
    print_info("Starting AnyPlot development server...")
    print(f"Project root: {project_root}")
    
    if args.load:
        print_info(f"Pre-loading dataset: {args.load}")
    
    try:
        # Start backend
        print_info("Starting backend server...")
        backend_cmd = ["uvicorn", "server.src.main:app", "--reload", "--port", "8000"]
        
        if args.debug:
            backend_cmd.append("--log-level=debug")
        
        print(f"\nCommand: {' '.join(backend_cmd)}")
        print("\nPress Ctrl+C to stop")
        print("=" * 60)
        
        subprocess.run(backend_cmd, cwd=project_root)
        
    except KeyboardInterrupt:
        print_info("\nShutting down...")
        return 0
    except Exception as e:
        print_error(f"Failed to start server: {e}")
        return 1

def generate_examples(args):
    """Generate example visualizations"""
    project_root = get_project_root()
    examples_dir = project_root / "examples" / "datasets"
    
    if not examples_dir.exists():
        print_error(f"Examples directory not found: {examples_dir}")
        return 1
    
    print_info("Generating example visualizations...")
    
    datasets = list(examples_dir.glob("*.csv"))
    print(f"Found {len(datasets)} example datasets")
    
    for dataset in datasets:
        print_info(f"\nProcessing: {dataset.name}")
        # This would generate actual visualizations
        print_warning("  (Not implemented - would generate viz here)")
    
    print_success("\nExample generation complete")
    return 0

def main():
    parser = argparse.ArgumentParser(
        description="AnyPlot CLI - Privacy-preserving data visualization",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  anyplot test-viz data.csv --prompt "Show revenue by region"
  anyplot check-privacy sensitive_data.csv --epsilon 0.5
  anyplot dev-server --debug
  anyplot export-session abc123 --output session.json

For more information: https://github.com/devYaoYH/anyplot
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Command to run')
    
    # test-viz command
    test_parser = subparsers.add_parser('test-viz', help='Test visualization with dataset')
    test_parser.add_argument('dataset', help='Path to CSV dataset')
    test_parser.add_argument('--prompt', help='Visualization prompt')
    test_parser.add_argument('--save', help='Save output image to file')
    test_parser.add_argument('--dry-run', action='store_true', help='Just validate, don\'t run')
    test_parser.set_defaults(func=test_viz)
    
    # validate-code command
    validate_parser = subparsers.add_parser('validate-code', help='Validate generated code')
    validate_parser.add_argument('file', help='Path to Python code file')
    validate_parser.set_defaults(func=validate_code)
    
    # check-privacy command
    privacy_parser = subparsers.add_parser('check-privacy', help='Analyze privacy budget')
    privacy_parser.add_argument('dataset', help='Path to CSV dataset')
    privacy_parser.add_argument('--epsilon', type=float, default=1.0, help='Epsilon budget')
    privacy_parser.set_defaults(func=check_privacy)
    
    # export-session command
    export_parser = subparsers.add_parser('export-session', help='Export session data')
    export_parser.add_argument('session_id', help='Session ID to export')
    export_parser.add_argument('--output', help='Output file path')
    export_parser.add_argument('--format', choices=['json', 'zip'], default='json')
    export_parser.set_defaults(func=export_session)
    
    # import-session command
    import_parser = subparsers.add_parser('import-session', help='Import session data')
    import_parser.add_argument('file', help='Session file to import')
    import_parser.set_defaults(func=import_session)
    
    # dev-server command
    dev_parser = subparsers.add_parser('dev-server', help='Start development server')
    dev_parser.add_argument('--load', help='Pre-load dataset')
    dev_parser.add_argument('--debug', action='store_true', help='Enable debug mode')
    dev_parser.set_defaults(func=dev_server)
    
    # generate-examples command
    examples_parser = subparsers.add_parser('generate-examples', help='Generate example visualizations')
    examples_parser.add_argument('--output-dir', help='Output directory')
    examples_parser.set_defaults(func=generate_examples)
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return 1
    
    try:
        return args.func(args)
    except KeyboardInterrupt:
        print_info("\nInterrupted")
        return 130
    except Exception as e:
        print_error(f"Unexpected error: {e}")
        import traceback
        traceback.print_exc()
        return 1

if __name__ == '__main__':
    sys.exit(main())
