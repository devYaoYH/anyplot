{
  "$schema": "./config.schema.json",
  "version": "1.0",
  "privacy": {
    "default_epsilon": 1.0,
    "max_budget_per_session": 10.0,
    "clip_percentiles": [1, 99],
    "min_samples_for_stats": 10
  },
  "sandbox": {
    "timeout_seconds": 30,
    "memory_limit_mb": 512,
    "allowed_imports": [
      "matplotlib",
      "matplotlib.pyplot",
      "pandas",
      "numpy",
      "seaborn",
      "plotly",
      "altair",
      "scipy"
    ],
    "blocked_imports": [
      "os",
      "subprocess",
      "socket",
      "sys",
      "__import__",
      "eval",
      "exec",
      "compile"
    ],
    "temp_dir": "/tmp/anyplot-sandbox"
  },
  "model": {
    "provider": "anthropic",
    "model_name": "claude-sonnet-4",
    "temperature": 0.7,
    "max_tokens": 4096,
    "system_prompt": "You are a data visualization assistant..."
  },
  "server": {
    "host": "localhost",
    "port": 8000,
    "cors_origins": ["http://localhost:5173", "http://localhost:3000"],
    "max_request_size_mb": 50,
    "session_timeout_minutes": 60
  },
  "frontend": {
    "theme": "light",
    "max_rows_preview": 1000,
    "sql_timeout_ms": 5000,
    "enable_debug_panel": false
  },
  "logging": {
    "level": "INFO",
    "format": "json",
    "output": "stdout",
    "privacy_audit_log": "./logs/privacy_audit.log",
    "performance_log": "./logs/performance.log"
  },
  "development": {
    "mock_mode": false,
    "hot_reload": true,
    "verbose_errors": true,
    "save_generated_code": true,
    "code_output_dir": "./generated_code"
  }
}
